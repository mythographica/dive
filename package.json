{
	"name": "@mnemonica/dive",
	"version": "0.9.0",
	"description": "Object-bound context propagation and execution-flow tracing — no ALS, no async_hooks",
	"type": "module",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"require": "./build-cjs/index.js",
			"default": "./build/index.js"
		}
	},
	"files": [
		"build/",
		"build-cjs/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"prepare": "husky",
		"build": "tsc && tsc -p tsconfig.cjs.json && node scripts/write-cjs-marker.js",
		"build:watch": "tsc --watch",
		"pretest": "npm run build",
		"test": "NODE_OPTIONS=--expose-gc vitest run",
		"test:cov": "NODE_OPTIONS=--expose-gc vitest run --coverage",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"@vitest/coverage-v8": "^2.1.9",
		"husky": "^9.1.7",
		"mnemonica": "^1.3.0",
		"typescript": "^5.9.3",
		"vitest": "^2.0.0"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mythographica/dive.git"
	},
	"bugs": {
		"url": "https://github.com/mythographica/dive/issues"
	},
	"homepage": "https://github.com/mythographica/dive#readme"
}
