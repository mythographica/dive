{
	"name": "@mnemonica/dive",
	"version": "0.3.1",
	"description": "Object-bound context propagation and execution-flow tracing — no ALS, no async_hooks",
	"type": "module",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		}
	},
	"files": [
		"build/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"build:watch": "tsc --watch",
		"pretest": "tsc",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"test:watch": "vitest",
		"prepublishOnly": "tsc"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"@vitest/coverage-v8": "^2.1.9",
		"mnemonica": "^1.2.5",
		"typescript": "^5.9.3",
		"vitest": "^2.0.0"
	},
	"license": "MIT"
}
