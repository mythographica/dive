{
	"name": "@mnemonica/dive",
	"version": "0.1.0",
	"description": "Context propagation for mnemonica instances — WeakMap-based, no ALS",
	"type": "module",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		},
		"./adapters/nestjs": {
			"types": "./build/adapters/nestjs.d.ts",
			"default": "./build/adapters/nestjs.js"
		},
		"./adapters/fastify": {
			"types": "./build/adapters/fastify.d.ts",
			"default": "./build/adapters/fastify.js"
		},
		"./adapters/express": {
			"types": "./build/adapters/express.d.ts",
			"default": "./build/adapters/express.js"
		}
	},
	"files": [
		"build/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"build:watch": "tsc --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"peerDependencies": {
		"mnemonica": "^0.9.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"mnemonica": "file:../core",
		"typescript": "^5.5.0",
		"vitest": "^2.0.0"
	}
}
